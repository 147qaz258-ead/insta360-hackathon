# Copy this file to config.env for local use. config.env is ignored by version control.
DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://your-workspace-host/compatible-mode/v1
# Native multimodal avoids large Base64 image timeouts seen on some compatible gateways.
QWEN_API_MODE=dashscope-native
QWEN_VL_MODEL=qwen3.8-max
QWEN_API_TIMEOUT=120
QWEN_ENABLE_THINKING=false
QWEN_STREAM=false
QWEN_TTS_MODEL=qwen-audio-3.0-tts-plus
QWEN_TTS_VOICE=Cherry
