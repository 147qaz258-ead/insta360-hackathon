# TouchSight API 配置（复制为 .env 并填入真实值）
# OpenAI 兼容端点（任一支持多图+function calling 的视觉模型均可）
TOUCHSIGHT_API_BASE=https://api.openai.com/v1
TOUCHSIGHT_API_KEY=sk-xxx
TOUCHSIGHT_MODEL=gpt-4o
# provider: openai | mock（mock 离线测试用）
TOUCHSIGHT_PROVIDER=openai
# Agent 最大循环步数
TOUCHSIGHT_MAX_STEPS=12

# 常见兼容端点参考：
# 阿里百炼 DashScope: TOUCHSIGHT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-vl-max-latest
# 智谱 GLM:           TOUCHSIGHT_API_BASE=https://open.bigmodel.cn/api/paas/v4              MODEL=glm-4v-plus
# Gemini(OpenAI兼容): TOUCHSIGHT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  MODEL=gemini-2.5-pro
